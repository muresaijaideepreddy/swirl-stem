# Configure secrets through the Sites environment settings; never commit real keys.
# The prototype rejects live keys and creates no real charges.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_ENABLED=false
# Google sign-in (OAuth 2.0 Web client). Authorized redirect URI: <SITE_ORIGIN>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local testing only: lets localhost requests use Sites dev identity headers. Never set in production.
LOCAL_TEST_AUTH=
CONTENT_ADMIN_USER_IDS=
# Bootstrap from an explicitly allowlisted, platform-verified owner email, then use stable user IDs.
CONTENT_ADMIN_EMAILS=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
# Inquiry notifications (pilot, contact, sample, quote, PO) go to TEAM_EMAIL, else the first CONTENT_ADMIN_EMAILS address.
TEAM_EMAIL=
RESEND_API_KEY=
EMAIL_FROM=
SITE_ORIGIN=https://swirl-stem-lab.ring-3-20260908-a6-p.chatgpt.site
